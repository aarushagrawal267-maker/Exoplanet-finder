# Exoplanet Finder configuration. Copy to .env (setup.ps1 does this for you).
# No API keys or paid services are required.

# Where downloaded catalogues, light curves, processed views and the SQLite DB live.
EXOF_DATA_DIR=./data
# Where trained model checkpoints and reports are written.
EXOF_ARTIFACTS_DIR=./artifacts
# SQLite database URL (leave empty to use <EXOF_DATA_DIR>/app.db)
EXOF_DB_URL=
# Compute device for PyTorch: auto | cpu | cuda
EXOF_DEVICE=auto
# Parallel downloads from NASA MAST (be polite: 2-8)
EXOF_DOWNLOAD_WORKERS=4
# Keep raw Kepler FITS files after processing (true uses much more disk)
EXOF_KEEP_RAW_FITS=false
# Backend server
EXOF_HOST=127.0.0.1
EXOF_PORT=8000
EXOF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EXOF_LOG_LEVEL=INFO
# Network timeouts (seconds)
EXOF_HTTP_TIMEOUT=60
# Frontend -> backend URL (used by Vite dev proxy)
VITE_API_URL=http://localhost:8000
